model Expense {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  category    String   @db.VarChar(50) // gaji, utilitas, sewa, internet, lainnya
  amount      Decimal  @default(0.00) @db.Decimal(15, 2)
  description String?  @db.Text
  expenseDate DateTime @map("expense_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId], map: "idx_expenses_user_id")
  @@index([category], map: "idx_expenses_category")
  @@index([expenseDate(sort: Desc)], map: "idx_expenses_expense_date")
  @@map("expenses")
}
